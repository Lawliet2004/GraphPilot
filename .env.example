# Copy to .env. Supply your own strong password in the DSN and Compose variables.
GP_DATABASE_URL=postgresql+psycopg://graphpilot:CHANGE_ME@127.0.0.1:5432/graphpilot
POSTGRES_USER=graphpilot
POSTGRES_DB=graphpilot
POSTGRES_PASSWORD=
GP_ENVIRONMENT=development
GP_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8000"]
GP_COOKIE_SECURE=false
# Optional Firebase Auth (Spark plan). Existing accounts need explicit UID linking.
# Web API key only; no service-account private key is needed.
GP_FIREBASE_PROJECT_ID=
GP_FIREBASE_API_KEY=
# Emulator is restricted to non-production loopback; leave empty for real Firebase.
GP_FIREBASE_EMULATOR_HOST=
GP_DATA_DIR=.data
# Local source access is off until an administrator explicitly configures roots.
GP_ALLOWED_LOCAL_ROOTS=[]
GP_FALKOR_HOST=127.0.0.1
GP_FALKOR_PORT=6379
GP_FALKOR_PASSWORD=
# Optional read-only Streamable HTTP MCP endpoint: /api/mcp/.
# Issue a per-user token using api.cli; browser cookies are not MCP credentials.
GP_MCP_ENABLED=false
# Deprecated: AI synthesis uses per-user BYOK credentials (Settings → AI
# synthesis). These variables are retained only so existing env files keep
# validating; they are never used to answer user questions.
GP_LLM_BASE_URL=
GP_LLM_MODEL=
GP_LLM_API_KEY=
GP_GITHUB_TOKEN=
GP_GITHUB_CLIENT_ID=
GP_GITHUB_CLIENT_SECRET=
GP_GITHUB_APP_SLUG=
# Generate once; retain across restarts/backups to decrypt GitHub and BYOK credentials.
GP_CREDENTIAL_KEY=
# Selected failed-job logs: text only, best-effort secret redaction before storage.
GP_MAX_LOG_BYTES=2000000
GP_MAX_LOG_DOWNLOADS=10
GP_SNAPSHOT_RETENTION_DAYS=30
GP_SNAPSHOT_KEEP_PER_BRANCH=10
GP_ARTIFACT_RETENTION_DAYS=30
# Optional password-reset email delivery (STARTTLS)
GP_SMTP_HOST=
GP_SMTP_PORT=587
GP_SMTP_USERNAME=
GP_SMTP_PASSWORD=
GP_SMTP_FROM=
GP_PUBLIC_URL=http://localhost:5173
# Compose uses private service DNS names, not host loopback.
GP_COMPOSE_DATABASE_URL=postgresql+psycopg://graphpilot:CHANGE_ME@postgres:5432/graphpilot
