  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The filled primary action; hover uses the theme-aware accent foreground.",
      "html": "<button class=\"ds-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>Connect repository</button>",
      "css": ".ds-primary{font-family:var(--sans, \"Manrope Variable\", sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 17px;border-radius:7px;font-size:12px;font-weight:650;line-height:1.6;border:1px solid transparent;transition:background .15s,color .15s;white-space:nowrap;min-height:42px;cursor:pointer;background:var(--ink, #252b49);color:var(--surface, #fff);}.ds-primary:hover{background:var(--accent, #a35f45);color:var(--on-accent, #fff);}.ds-primary:focus-visible{outline:2px solid var(--accent, #a35f45);outline-offset:4px;}.ds-primary:disabled{cursor:not-allowed;opacity:.48;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none!important;animation:none!important;}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered actions alongside the primary task.",
      "html": "<button class=\"ds-secondary\">Cancel</button>",
      "css": ".ds-secondary{font-family:var(--sans, \"Manrope Variable\", sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 17px;border-radius:7px;font-size:12px;font-weight:650;line-height:1.6;border:1px solid transparent;transition:background .15s,color .15s;white-space:nowrap;min-height:42px;cursor:pointer;background:var(--surface, #fff);border-color:var(--line, #e1e3e7);color:var(--ink, #252b49);}.ds-secondary:hover{border-color:var(--line-strong, #b8bfcd);background:var(--soft, #f0f0ec);}.ds-secondary:focus-visible{outline:2px solid var(--accent, #a35f45);outline-offset:4px;}.ds-secondary:disabled{cursor:not-allowed;opacity:.48;}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none!important;animation:none!important;}}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "An unenclosed inline source or retry action.",
      "html": "<button class=\"ds-text\">View source<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-text{font-family:var(--sans, \"Manrope Variable\", sans-serif);display:inline-flex;align-items:center;gap:7px;border:0;background:none;padding:0;color:var(--accent, #a35f45);font-size:12px;font-weight:600;line-height:1.6;cursor:pointer;}.ds-text:focus-visible{outline:2px solid var(--accent, #a35f45);outline-offset:4px;}.ds-text:disabled{cursor:not-allowed;opacity:.48;}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Compact graph and shell controls with an accessible name.",
      "html": "<button class=\"ds-icon\" aria-label=\"Zoom in\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg></button>",
      "css": ".ds-icon{font-family:var(--sans, \"Manrope Variable\", sans-serif);display:inline-flex;align-items:center;justify-content:center;min-height:32px;min-width:32px;border:0;border-radius:5px;background:transparent;color:var(--ink, #252b49);cursor:pointer;}.ds-icon:hover{background:var(--soft, #f0f0ec);}.ds-icon:focus-visible{outline:2px solid var(--accent, #a35f45);outline-offset:4px;}.ds-icon:disabled{cursor:not-allowed;opacity:.48;}"
    },
    {
      "name": "Labeled Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Default field, its label, placeholder, focus halo and disabled treatment.",
      "html": "<label class=\"ds-field\">Name<input placeholder=\"Your name\" /></label>",
      "css": ".ds-field{font-family:var(--sans, \"Manrope Variable\", sans-serif);display:grid;gap:7px;font-size:13px;font-weight:600;line-height:1.6;color:var(--ink, #252b49);}.ds-field input{font-family:var(--sans, \"Manrope Variable\", sans-serif);font-size:14px;line-height:1.6;font-weight:400;width:100%;min-height:43px;border:1px solid var(--line, #e1e3e7);background:var(--surface, #fff);border-radius:7px;padding:10px 12px;color:var(--ink, #252b49);outline:none;caret-color:var(--accent, #a35f45);}.ds-field input::placeholder{color:var(--subtle, #60687a);}.ds-field input:focus{border-color:var(--accent, #a35f45);box-shadow:0 0 0 3px var(--focus, #d0b3a42e);}.ds-field input:focus-visible{outline:2px solid var(--accent, #a35f45);outline-offset:4px;}.ds-field input:disabled{background:var(--soft, #f0f0ec);color:var(--muted, #666d80);}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "A fixed indigo navigation material with hover and active route states.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Main navigation\"><a href=\"#workspace\" class=\"ds-nav-item ds-nav-active\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 19a5 5 0 0 1-5-5v8\"/><path d=\"M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5\"/><circle cx=\"13\" cy=\"12\" r=\"2\"/><circle cx=\"20\" cy=\"19\" r=\"2\"/></svg>Repositories</a><a href=\"#activity\" class=\"ds-nav-item\">Activity</a></nav>",
      "css": ".ds-rail{font-family:var(--sans, \"Manrope Variable\", sans-serif);background:#252b49;padding:12px;display:grid;gap:4px;width:225px;}.ds-nav-item{display:flex;align-items:center;gap:11px;padding:11px 13px;border:0;background:transparent;color:#bec5dd;font-size:12px;line-height:1.6;text-align:left;border-radius:7px;width:100%;text-decoration:none;}.ds-nav-item:hover{background:#303858;color:#fff;}.ds-nav-active{background:#3a4262;color:#fff;}.ds-nav-item:focus-visible{outline:2px solid var(--accent, #a35f45);outline-offset:4px;}"
    },
    {
      "name": "Status Labels",
      "kind": "chip",
      "refersTo": "status",
      "description": "A written state and dot, with semantic success, warning and error pairs.",
      "html": "<div class=\"ds-status-set\"><span class=\"ds-status ds-ready\"><span></span>ready</span><span class=\"ds-status ds-running\"><span></span>indexing</span><span class=\"ds-status ds-failed\"><span></span>failed</span></div>",
      "css": ".ds-status-set{display:flex;gap:8px;flex-wrap:wrap;}.ds-status{font-family:var(--sans, \"Manrope Variable\", sans-serif);display:inline-flex;align-items:center;gap:6px;border-radius:5px;padding:3px 7px;font-size:10px;font-weight:650;line-height:1.6;text-transform:capitalize;color:var(--muted, #666d80);background:var(--soft, #f0f0ec);white-space:nowrap;}.ds-status>span{width:5px;height:5px;border-radius:50%;background:currentColor;}.ds-ready{color:var(--success, #4c7560);background:var(--success-bg, #edf4ee);}.ds-running{color:var(--warning, #8a6b31);background:var(--warning-bg, #fbf3e2);}.ds-failed{color:var(--error, #a54845);background:var(--error-bg, #fbeeed);}"
    },
    {
      "name": "Repository Card",
      "kind": "card",
      "refersTo": "repository-card",
      "description": "A flat repository link; sample content omits invented usage metrics.",
      "html": "<a class=\"ds-repo-card\" href=\"#repository\"><span class=\"ds-repo-icon\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 19a5 5 0 0 1-5-5v8\"/><path d=\"M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5\"/><circle cx=\"13\" cy=\"12\" r=\"2\"/><circle cx=\"20\" cy=\"19\" r=\"2\"/></svg></span><h3>GraphPilot</h3><p class=\"ds-repo-source\">Source reference</p><div class=\"ds-repo-footer\"><span>main</span><span>Awaiting index</span></div></a>",
      "css": ".ds-repo-card{font-family:var(--sans, \"Manrope Variable\", sans-serif);display:block;max-width:340px;border:1px solid var(--line, #e1e3e7);padding:23px 24px 0;border-radius:12px;background:var(--surface, #fff);color:var(--ink, #252b49);transition:border-color .15s,background .15s;overflow:hidden;text-decoration:none;line-height:1.6;}.ds-repo-card:hover{border-color:var(--line-strong, #b8bfcd);background:var(--soft, #f0f0ec);}.ds-repo-card:focus-visible{outline:2px solid var(--accent, #a35f45);outline-offset:4px;}.ds-repo-icon{display:flex;color:var(--accent, #a35f45);margin-bottom:21px;}.ds-repo-card h3{margin:0;font-size:18px;font-weight:650;line-height:1.25;letter-spacing:-.025em;overflow-wrap:anywhere;}.ds-repo-source{font-size:11px;margin:6px 0 0;color:var(--muted, #666d80);overflow-wrap:anywhere;}.ds-repo-footer{display:flex;justify-content:space-between;border-top:1px solid var(--line, #e1e3e7);padding:13px 0;margin-top:22px;font-size:9px;color:var(--muted, #666d80);}.ds-repo-footer>span:first-child{font-family:var(--mono, \"IBM Plex Mono\", monospace);font-size:10px;}@media(prefers-reduced-motion:reduce){.ds-repo-card,.ds-repo-footer,.ds-repo-icon,.ds-repo-source{transition:none!important;animation:none!important;}}"
    },
    {
      "name": "Selected Source Summary",
      "kind": "custom",
      "refersTo": "selected-summary",
      "description": "The selected symbol stays in view before the graph with a direct source action.",
      "html": "<div class=\"ds-selected\"><span><strong>checkout</strong> · Function</span><button class=\"ds-source-action\">View source<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button></div>",
